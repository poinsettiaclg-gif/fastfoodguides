---
// src/components/NewsletterSignup.astro
---
<div class="newsletter-card">
  <div class="newsletter-header">
    <h3>Weekly Shift Notes</h3>
    <span class="badge">Join 5,000+ Managers</span>
  </div>
  <p class="newsletter-desc">
    Get the unpolished operational hacks corporate won't teach you. 
    <strong>Bonus:</strong> Subscribe now to get our free <em>5-Minute Audit Survival Checklist (PDF)</em> immediately.
  </p>
  <form id="newsletter-form" class="newsletter-form" action="https://formspree.io/f/meeybzwj" method="POST">
    <div class="input-group">
      <input type="email" id="newsletter-email" name="email" placeholder="manager@store.com" required aria-label="Email address" />
      <button type="submit" id="newsletter-submit">Send Checklist</button>
    </div>
    <p class="privacy-note">No spam. Unsubscribe anytime.</p>
  </form>
  <div id="newsletter-success" style="display: none;" class="success-message">
    <strong>Success!</strong> The 5-Minute Audit Survival Checklist has been sent to your inbox.
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const forms = document.querySelectorAll('.newsletter-form');
    
    forms.forEach(form => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const formEl = e.target as HTMLFormElement;
        const submitBtn = formEl.querySelector('button[type="submit"]') as HTMLButtonElement;
        const successMsg = formEl.nextElementSibling as HTMLElement;
        const actionUrl = formEl.getAttribute('action') || '';
        
        // Prevent multiple submissions
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending...';
        
        const formData = new FormData(formEl);
        
        try {
          const response = await fetch(actionUrl, {
            method: 'POST',
            body: formData,
            headers: {
              'Accept': 'application/json'
            }
          });
          
          if (response.ok) {
            formEl.style.display = 'none';
            if (successMsg) {
              successMsg.style.display = 'block';
            }
            if (typeof gtag === 'function') {
              gtag('event', 'generate_lead', {
                'event_category': 'newsletter',
                'event_label': 'weekly_shift_notes'
              });
            }
          } else {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Error. Try Again.';
          }
        } catch (error) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Error. Try Again.';
        }
      });
    });
  });
</script>

<style>
  .newsletter-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-accent);
    border-radius: var(--radius-card);
    padding: 1.5rem;
    margin: 2rem 0;
    box-shadow: var(--shadow-card);
    position: relative;
    overflow: hidden;
  }
  .newsletter-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: var(--accent-gradient);
  }
  .newsletter-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .newsletter-header h3 {
    margin: 0;
    font-size: 1.25rem;
    color: var(--text-primary);
  }
  .badge {
    background: rgba(16, 185, 129, 0.15);
    color: var(--accent-light);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    border: 1px solid var(--border-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .newsletter-desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }
  .newsletter-desc strong {
    color: var(--accent-light);
  }
  .newsletter-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .input-group {
    display: flex;
    gap: 0.5rem;
  }
  .newsletter-form input {
    flex: 1;
    background: var(--bg-body);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-btn);
    padding: 0.75rem 1rem;
    color: var(--text-primary);
    font-size: 1rem;
    outline: none;
    transition: border-color var(--transition);
  }
  .newsletter-form input:focus {
    border-color: var(--accent);
  }
  .newsletter-form button {
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: var(--radius-btn);
    padding: 0.75rem 1.25rem;
    font-weight: 700;
    cursor: pointer;
    transition: background var(--transition);
  }
  .newsletter-form button:hover {
    background: var(--accent-light);
  }
  .privacy-note {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin: 0;
    text-align: center;
  }
  
  @media (max-width: 600px) {
    .input-group {
      flex-direction: column;
    }
    .newsletter-form button {
      width: 100%;
    }
  }
  .success-message {
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid var(--accent);
    color: var(--accent-light);
    padding: 1rem;
    border-radius: var(--radius-btn);
    font-size: 0.95rem;
    text-align: center;
    margin-top: 1rem;
  }
</style>
