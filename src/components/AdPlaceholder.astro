---
import { SITE_CONFIG } from '../consts';

interface Props {
	slot: string;
}

// Check central config for AdSense approval status.
const { slot } = Astro.props;
const isApproved = SITE_CONFIG?.adsenseApproved || false;
---

<div class="ad-container" data-ad-position={slot} data-ad-status={isApproved ? "active" : "pending"}>
	<span class="ad-label">Advertisement</span>
	<div class="ad-slot-placeholder">
		{isApproved && (
			<ins class="adsbygoogle"
				style="display:block"
				data-ad-client="ca-pub-4755826230930575"
				data-ad-slot="XXXXXXXXXX"
				data-ad-format="auto"
				data-full-width-responsive="true">
			</ins>
			<script is:inline>
				(window.adsbygoogle = window.adsbygoogle || []).push({});
			</script>
		)}
	</div>
</div>

<style>
	.ad-container {
		margin: 3rem 0;
		text-align: center;
		width: 100%;
		max-width: 100%;
		box-sizing: border-box;
		display: block;
		padding: 0.5rem 0;
		contain: layout;
		contain-intrinsic-size: 250px;
	}

	.ad-label {
		display: block;
		margin-bottom: 0.35rem;
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: #64748B;
		font-weight: 600;
	}

	.ad-slot-placeholder {
		width: 100%;
		background: rgba(255, 255, 255, 0.015);
		border-radius: 0.5rem;
		display: block;
		transition: border-color 0.2s ease;
	}

	/* Default min-height for mobile/inline slots */
	.ad-slot-placeholder {
		min-height: 250px;
	}

	/* Sidebar sticky needs 600px for half-page ads on desktop */
	[data-ad-position="sidebar-sticky"] .ad-slot-placeholder {
		min-height: 600px;
	}
	
	@media (min-width: 1024px) {
		[data-ad-position="post-bottom"] .ad-slot-placeholder,
		[data-ad-position="secret-menu-bottom"] .ad-slot-placeholder {
			min-height: 280px;
		}
	}
</style>
