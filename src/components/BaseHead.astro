---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import '@fontsource/atkinson-hyperlegible';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: string;
	ogType?: string;
	chain?: string;
	hasChainPage?: boolean;
	articlePath?: string;
	pubDate?: Date;
	updatedDate?: Date;
	noindex?: boolean;
	author?: string;
}

let pathname = Astro.url.pathname;
if (!pathname.endsWith('/') && !pathname.split('/').pop()?.includes('.')) {
	pathname += '/';
}
const canonicalURL = new URL(pathname, Astro.site);
const isHomepage = Astro.url.pathname === '/' || Astro.url.pathname === '';

const { title, description, image, ogType = 'website', chain, hasChainPage = true, articlePath, pubDate, updatedDate, noindex = false, author = "Russell Roseberry" } = Astro.props;

const displayTitle = (isHomepage || title.includes(SITE_TITLE)) ? title : `${title} | ${SITE_TITLE}`;
const ogImageUrl = image ? new URL(image, Astro.site) : new URL('/og-default.png', Astro.site);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#0a0f1c" />

<!-- Preconnect to external domains -->
<link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
<link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />



<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{displayTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={author} />
{noindex ? (
	<meta name="robots" content="noindex, follow" />
) : (
	<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
)}

<!-- Open Graph / Facebook -->
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="en_US" />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={displayTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:alt" content={displayTitle} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<!-- Article OG Tags -->
{ogType === 'article' && (
	<meta property="article:author" content={author} />
)}
{ogType === 'article' && pubDate && (
	<meta property="article:published_time" content={pubDate.toISOString()} />
)}
{ogType === 'article' && updatedDate && (
	<meta property="article:modified_time" content={updatedDate.toISOString()} />
)}
{ogType === 'article' && chain && (
	<meta property="article:section" content={chain} />
)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@fastfoodguides" />
<meta name="twitter:creator" content="@fastfoodguides" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={displayTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={displayTitle} />



<!-- JSON-LD Structured Data (homepage only) -->
{isHomepage && (
	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@graph": [{
			"@type": "WebSite",
			"name": SITE_TITLE,
			"url": Astro.site,
			"description": description,
			"publisher": {
				"@type": "Organization",
				"name": SITE_TITLE,
				"url": Astro.site,
				"logo": {
					"@type": "ImageObject",
					"url": new URL("/og-default.png", Astro.site).href,
					"width": 1200,
					"height": 630
				}
			}
		}]
	}).replace(/</g, '\\u003c')} />
)}

<!-- Google Consent Mode v2 + GA4 (single unified block) -->
<script type="text/partytown" async src="https://www.googletagmanager.com/gtag/js?id=G-LTBYBPFE6W"></script>
<script is:inline>
	window.dataLayer = window.dataLayer || [];
	function gtag(){dataLayer.push(arguments);}

	// Default: GRANT analytics (so we always track), deny ads until consent
	gtag('consent', 'default', {
		'ad_storage': 'denied',
		'ad_user_data': 'denied',
		'ad_personalization': 'denied',
		'analytics_storage': 'granted',
		'wait_for_update': 500
	});

	var consent = null;
	try {
		consent = localStorage.getItem('cookie-consent');
	} catch(e) {}
	if (consent === 'accepted') {
		gtag('consent', 'update', {
			'ad_storage': 'granted',
			'ad_user_data': 'granted',
			'ad_personalization': 'granted',
			'analytics_storage': 'granted'
		});
	} else if (consent === 'rejected') {
		gtag('consent', 'update', {
			'ad_storage': 'denied',
			'ad_user_data': 'denied',
			'ad_personalization': 'denied',
			'analytics_storage': 'denied'
		});
	}

	// GA4 config — fires in the same context as gtag() so it always works
	gtag('js', new Date());
	gtag('config', 'G-LTBYBPFE6W');

	// Global Event Tracking
	document.addEventListener('click', function(e) {
		const target = e.target.closest('.btn-amazon');
		if (target) {
			gtag('event', 'affiliate_click', {
				'link_url': target.href,
				'link_classes': target.className,
				'outbound': true
			});
		}

		const calloutTarget = e.target.closest('.callout-gear a');
		if (calloutTarget) {
			gtag('event', 'affiliate_click', {
				'link_url': calloutTarget.href,
				'link_classes': 'callout-gear',
				'outbound': true
			});
		}

		const gumroadTarget = e.target.closest('.gumroad-button');
		if (gumroadTarget) {
			gtag('event', 'begin_checkout', {
				'event_category': 'ecommerce',
				'event_label': 'gumroad_checkout',
				'item_url': gumroadTarget.href
			});
		}
	});

	// Time on page tracking (60 seconds)
	setTimeout(function() {
		if (typeof gtag === 'function') {
			gtag('event', 'time_on_page', {
				'event_category': 'engagement',
				'event_label': '60_seconds'
			});
		}
	}, 60000);
</script>

