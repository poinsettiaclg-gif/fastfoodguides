---
interface Props {
	title: string;
	description: string;
	imageUrl: string;
	amazonLink: string;
}

const { title, description, imageUrl, amazonLink } = Astro.props;
---

<div class="product-card">
	<div class="product-card-image">
		<img src={imageUrl} alt={title} loading="lazy" width="100" height="100" />
	</div>
	<div class="product-card-content">
		<h4 class="product-card-title">{title}</h4>
		<div class="product-card-desc">
			<p>{description}</p>
		</div>
		<a href={amazonLink} target="_blank" rel="noopener noreferrer nofollow" class="btn btn-amazon">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:0.5em;"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
			Check Price on Amazon
		</a>
	</div>
</div>
