---
import { Image } from 'astro:assets';
interface Props {
	title: string;
	description: string;
	imageUrl: string;
	amazonLink: string;
}

const { title, description, imageUrl, amazonLink } = Astro.props;
---

<div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-6 p-6 my-8 bg-slate-900 border border-slate-800 rounded-xl shadow-md hover:shadow-lg transition-shadow">
	<div class="shrink-0 w-[120px] h-[120px] bg-white rounded-lg p-2 flex items-center justify-center mx-auto sm:mx-0">
		<Image src={imageUrl} alt={title} width={100} height={100} loading="lazy" format="webp" class="max-h-full w-auto" />
	</div>
	<div class="grow flex flex-col justify-center">
		<h4 class="text-xl font-bold text-slate-100 mt-0 mb-2">{title}</h4>
		<div class="text-[0.95em] text-slate-400 mb-4">
			<p class="m-0">{description}</p>
		</div>
		<a href={amazonLink} target="_blank" rel="noopener noreferrer nofollow" class="btn-amazon w-full sm:w-auto inline-flex items-center justify-center bg-[#FF9900] hover:bg-[#e68a00] text-black font-bold py-2.5 px-5 rounded-lg transition-transform hover:-translate-y-0.5">
			<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
			Check Price on Amazon
		</a>
	</div>
</div>
