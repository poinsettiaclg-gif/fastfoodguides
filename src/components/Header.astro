---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav aria-label="Main navigation">
		<a href="/" class="brand">
			<img src="/favicon.svg" alt="Fast Food Guides Logo" class="brand-icon" width="32" height="32" />
			<span class="brand-name">{SITE_TITLE}</span>
		</a>

		<button
			class="menu-toggle"
			aria-label="Toggle navigation menu"
			aria-expanded="false"
			aria-controls="nav-links"
		>
			<span class="hamburger" aria-hidden="true"></span>
		</button>

		<div class="nav-links" id="nav-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/articles/">Guides</HeaderLink>
			<HeaderLink href="/secret-menus/" class="header-cta">Secret Menus</HeaderLink>
			<HeaderLink href="/about/">About</HeaderLink>
			<HeaderLink href="/contact/">Contact</HeaderLink>
		</div>
	</nav>
</header>

<script>
	function initNav() {
		const toggle = document.querySelector('.menu-toggle');
		const navLinks = document.querySelector('.nav-links');

		if (toggle && navLinks && !toggle.hasAttribute('data-nav-init')) {
			toggle.setAttribute('data-nav-init', 'true');
			toggle.addEventListener('click', (e) => {
				e.stopPropagation();
				const isOpen = navLinks.classList.toggle('open');
				toggle.setAttribute('aria-expanded', String(isOpen));
				toggle.classList.toggle('active', isOpen);
			});

			// Close menu when clicking a link (mobile)
			navLinks.querySelectorAll('a').forEach((link) => {
				link.addEventListener('click', () => {
					navLinks.classList.remove('open');
					toggle.classList.remove('active');
					toggle.setAttribute('aria-expanded', 'false');
				});
			});

			// Close menu when clicking outside (bind globally only once)
			if (!window._navClickInit) {
				window._navClickInit = true;
				document.addEventListener('click', (e) => {
					const activeNav = document.querySelector('.nav-links.open');
					const activeToggle = document.querySelector('.menu-toggle.active');
					if (activeNav && !activeNav.contains(e.target as Node) && !activeToggle?.contains(e.target as Node)) {
						activeNav.classList.remove('open');
						if (activeToggle) {
							activeToggle.classList.remove('active');
							activeToggle.setAttribute('aria-expanded', 'false');
						}
					}
				});

				// Focus trap for mobile menu
				document.addEventListener('keydown', (e) => {
					const activeNav = document.querySelector('.nav-links.open');
					if (!activeNav) return;
					
					const focusable = activeNav.querySelectorAll('a, button, [href], [tabindex]:not([tabindex="-1"])');
					if (focusable.length === 0) return;
					
					const first = focusable[0] as HTMLElement;
					const last = focusable[focusable.length - 1] as HTMLElement;
					const toggleBtn = document.querySelector('.menu-toggle.active') as HTMLElement;
					
					if (e.key === 'Escape') {
						activeNav.classList.remove('open');
						if (toggleBtn) {
							toggleBtn.classList.remove('active');
							toggleBtn.setAttribute('aria-expanded', 'false');
							toggleBtn.focus();
						}
						return;
					}
					
					if (e.key === 'Tab') {
						if (e.shiftKey && document.activeElement === first) {
							e.preventDefault();
							last.focus();
						} else if (!e.shiftKey && document.activeElement === last) {
							e.preventDefault();
							first.focus();
						}
					}
				});
			}
		}
	}

	// Run on initial load
	initNav();
</script>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 9999;
		background-color: var(--bg-surface);
		border-bottom: 1px solid rgba(16, 185, 129, 0.15);
		backdrop-filter: blur(12px);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 1.5em;
		height: 4rem;
	}

	/* Brand */
	.brand {
		display: flex;
		align-items: center;
		gap: 0.5em;
		text-decoration: none;
		color: var(--text-primary);
		flex-shrink: 0;
		min-height: 44px; /* WCAG touch target */
	}
	.brand:hover {
		color: var(--text-primary);
	}
	.brand-icon {
		width: 2rem;
		height: 2rem;
		object-fit: contain;
	}
	.brand-name {
		font-weight: 700;
		font-size: 1.15rem;
		letter-spacing: -0.01em;
	}

	/* Nav links container */
	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.25em;
	}

	.nav-links :global(.header-cta) {
		background: var(--accent);
		color: var(--bg-body) !important;
		padding: 0.6rem 1.25rem !important; /* increased for 44px min height */
		min-height: 44px;
		display: inline-flex;
		align-items: center;
		border-radius: 999px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		font-size: 0.85rem;
		margin-left: 0.5rem;
		transition: all 0.2s ease;
		border-bottom: none !important;
	}

	.nav-links :global(.header-cta:hover) {
		background: #059669;
		transform: translateY(-1px);
		box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
	}

	/* Hamburger toggle — hidden on desktop */
	.menu-toggle {
		display: none;
		background: none;
		border: none;
		padding: 0.5em;
		cursor: pointer;
		position: relative;
		width: 3rem;
		height: 3rem;
		border-radius: 0.375rem;
		transition: background-color 0.2s ease;
	}
	.menu-toggle:hover {
		background-color: rgba(255, 255, 255, 0.05);
	}

	.hamburger,
	.hamburger::before,
	.hamburger::after {
		display: block;
		width: 20px;
		height: 2px;
		background-color: #94A3B8;
		border-radius: 1px;
		transition: transform 0.25s ease, opacity 0.2s ease;
	}
	.hamburger {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
	}
	.hamburger::before {
		content: '';
		position: absolute;
		top: -6px;
		left: 0;
	}
	.hamburger::after {
		content: '';
		position: absolute;
		bottom: -6px;
		left: 0;
	}

	/* Animated X state */
	.menu-toggle.active .hamburger {
		background-color: transparent;
	}
	.menu-toggle.active .hamburger::before {
		top: 0;
		transform: rotate(45deg);
		background-color: var(--accent);
	}
	.menu-toggle.active .hamburger::after {
		bottom: 0;
		transform: rotate(-45deg);
		background-color: var(--accent);
	}

	/* Mobile styles */
	@media (max-width: 720px) {
		.menu-toggle {
			display: block;
		}

		.nav-links {
			display: none;
			position: absolute;
			top: 4rem;
			left: 0;
			right: 0;
			max-height: calc(100vh - 4rem);
			overflow-y: auto;
			flex-direction: column;
			background-color: var(--bg-surface);
			border-bottom: 1px solid rgba(16, 185, 129, 0.15);
			padding: 0.75em 1.5em 1em;
			gap: 0;
			box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3);
		}

		.nav-links.open {
			display: flex;
		}

		.nav-links :global(a) {
			padding: 1rem 1rem;
			width: 100%;
			border-radius: 0.5rem;
			margin-bottom: 0.5rem;
		}
		.nav-links :global(a:hover) {
			background-color: rgba(255, 255, 255, 0.05);
		}
		.nav-links :global(.header-cta) {
			margin-left: 0;
			justify-content: center;
		}
	}
</style>
