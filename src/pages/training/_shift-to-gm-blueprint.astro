---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import GumroadCheckout from '../../components/GumroadCheckout.astro';
import { SITE_TITLE } from '../../consts';

const title = "Shift to GM Blueprint | ${SITE_TITLE}";
const description = "The ultimate operational framework to jump from Shift Manager to General Manager in 90 days.";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<a href="#main-content" class="sr-only skip-link">Skip to main content</a>
		<Header />

		<main id="main-content" class="sales-page">
			<!-- HERO SECTION -->
			<section class="hero-section">
				<div class="hero-bg" aria-hidden="true"></div>
				<div class="container hero-content">
					<span class="eyebrow">The 90-Day Fast Track</span>
					<h1 class="headline">Stop Running Shifts. <br/><span class="gradient-text">Start Running the Store.</span></h1>
					<p class="subheadline">
						The exact operational framework and management blueprint I used to go from an exhausted Shift Lead to a high-performing General Manager. No corporate fluff, just battle-tested strategies.
					</p>
					<div class="cta-group">
						<a href="#pricing" class="primary-btn">Get the Blueprint</a>
						<a href="#modules" class="secondary-btn">See What's Inside</a>
					</div>
				</div>
			</section>

			<!-- SOCIAL PROOF / LOGOS -->
			<section class="social-proof">
				<div class="container">
					<p>Trusted by managers running units at:</p>
					<div class="logos">
						<span>🍔 McDonald's</span>
						<span>🌮 Taco Bell</span>
						<span>🍗 Chick-fil-A</span>
						<span>☕ Starbucks</span>
					</div>
				</div>
			</section>

			<!-- THE PROBLEM -->
			<section class="problem-section">
				<div class="container">
					<h2 class="section-title">You're Doing a GM's Job on a Shift Manager's Salary.</h2>
					<p class="section-desc">You're running the floor. You're covering call-outs. You're hitting labor targets while sweating over a broken fryer. But when the Store Manager leaves, you're the one left holding the bag—for a fraction of the pay. The difference between a Shift Supervisor and a General Manager isn't working harder. It's having the right tools. It's time to stop renting your title and start owning your P&L with plug-and-play templates.</p>
					
					<div class="objection-block" style="background: rgba(30,41,59,0.5); padding: 2rem; border-radius: 1rem; margin-top: 3rem; border-left: 4px solid var(--accent);">
						<h3 style="color: #fff; margin-bottom: 1rem;">"Why would they promote me when I'm already doing the work for $16/hour?"</h3>
						<p style="color: #94a3b8; font-size: 1.05rem;">Because a burned-out Shift Lead is a massive flight risk. Area Coaches know that if they don't promote their best operators, a competitor will. This Blueprint doesn't replace the grit and 'trial by fire' you've already endured on the floor—it organizes your experience into a corporate language that proves to Upper Management you are ready for the keys.</p>
					</div>
				</div>
			</section>

			<!-- MODULES SECTION -->
			<section id="modules" class="modules-section">
				<div class="container">
					<h2 class="section-title">The Operational Toolkit</h2>
					<div class="modules-grid">
						<div class="module-card">
							<div class="module-number">Tool 1</div>
							<h3 class="module-title">The Bulletproof Labor Matrix (Excel/CSV)</h3>
							<p class="module-desc">A plug-and-play spreadsheet. Input your sales forecast and it instantly tells you exactly how many labor hours you can schedule without blowing the budget.</p>
						</div>
						<div class="module-card">
							<div class="module-number">Tool 2</div>
							<h3 class="module-title">The Area Coach Interview Portfolio</h3>
							<p class="module-desc">A fill-in-the-blank brag sheet. Print this out and hand it to your boss during a promotion interview to prove you understand the numbers.</p>
						</div>
						<div class="module-card">
							<div class="module-number">Tool 3</div>
							<h3 class="module-title">Hiring & Retention Scripts</h3>
							<p class="module-desc">Copy-paste text messages for no-shows, interview question cheat sheets, and onboarding checklists to stop the revolving door of new hires.</p>
						</div>
						<div class="module-card">
							<div class="module-number">Tool 4</div>
							<h3 class="module-title">P&L Manipulation Guide</h3>
							<p class="module-desc">A cheat sheet for reading the Profit & Loss statement. Learn exactly which 3 levers to pull to drop your food cost variance before the end of the month.</p>
						</div>
					</div>
					
					<h2 class="section-title" style="margin-top: 4rem;">Plus 3 Fast-Action <span class="gradient-text">Bonuses</span></h2>
					<div class="modules-grid">
						<div class="module-card bonus-card">
							<div class="module-number">Bonus 1</div>
							<h3 class="module-title">The 90-Day GM Roadmap <span style="font-size: 0.9rem; color: #94a3b8;">(Value: $97)</span></h3>
							<p class="module-desc">A day-by-day execution checklist. Exactly what to do your first 90 days as a GM to secure your position and hit your first quarterly bonus.</p>
						</div>
						<div class="module-card bonus-card">
							<div class="module-number">Bonus 2</div>
							<h3 class="module-title">Laminated Crisis Playbook <span style="font-size: 0.9rem; color: #94a3b8;">(Value: $47)</span></h3>
							<p class="module-desc">Printable 1-page emergency protocols. Exactly what to do when the health inspector walks in or the walk-in fridge dies mid-shift.</p>
						</div>
						<div class="module-card bonus-card">
							<div class="module-number">Bonus 3</div>
							<h3 class="module-title">Weekly Office Hours <span style="font-size: 0.9rem; color: #94a3b8;">(Value: $197/yr)</span></h3>
							<p class="module-desc">Access to our private mastermind. Get direct advice from me on how to handle difficult employees or strict owners in real-time.</p>
						</div>
					</div>
				</div>
			</section>

			<!-- TESTIMONIALS SECTION -->
			<section class="testimonials-section">
				<div class="container">
					<h2 class="section-title">Real Results from Real Managers</h2>
					<div class="testimonials-grid">
						<div class="testimonial-card">
							<div class="stars">★★★★★</div>
							<p class="quote">"I was stuck on night shifts for 3 years, pulling my hair out. I used the P&L strategies in Module 1 to lower our food cost variance by 1.2% in a single month. The Area Manager noticed immediately. Promoted to GM 4 months later."</p>
							<div class="author">
								<div class="avatar">SJ</div>
								<div class="info">
									<div class="name">Sarah J.</div>
									<div class="role">GM, Major Burger Chain</div>
								</div>
							</div>
						</div>
						<div class="testimonial-card">
							<div class="stars">★★★★★</div>
							<p class="quote">"The scheduling matrix alone was worth the price. I finally got my life back, stopped working 12-hour turn-and-burns, and proved to the franchise owners that I could run a profitable store without burning out the crew."</p>
							<div class="author">
								<div class="avatar">MR</div>
								<div class="info">
									<div class="name">Mike R.</div>
									<div class="role">GM, Fast Casual</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- PRICING SECTION -->
			<section id="pricing" class="pricing-section">
				<div class="container">
					<h2 class="section-title">Invest in Your Career</h2>
					<div class="pricing-card-wrapper">
						<div class="pricing-card">
							<div class="popular-badge">Most Popular</div>
							<h3 class="plan-name">The Full Blueprint</h3>
							<div class="price-box">
								<div class="price-strike">$197</div>
								<div class="price-current">$47</div>
							</div>
							<p class="value-stack" style="color: #94a3b8; font-size: 0.9rem; margin-top: -0.5rem; margin-bottom: 1rem; text-decoration: line-through;">Total Value: $538</p>
							<p class="guarantee">30-Day Money Back Guarantee</p>
							<ul class="guarantee-list">
								<li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> Instant Download</li>
								<li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> Done-For-You Excel Templates</li>
								<li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> <strong>Bonus:</strong> Crisis Playbook</li>
								<li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> Lifetime Access & Updates</li>
							</ul>
							<GumroadCheckout />
						</div>
					</div>
				</div>
			</section>

		</main>
		<Footer />

		<style>
			/* Base Styles */
			.sales-page {
				width: 100%;
				margin: 0;
				padding: 0;
				font-family: var(--font-body, system-ui, -apple-system, sans-serif);
				color: var(--text-primary, #f8fafc);
				background-color: var(--bg-body, #0f172a);
				line-height: 1.6;
			}
			.container {
				max-width: 1100px;
				margin: 0 auto;
				padding: 0 1.5rem;
			}
			.gradient-text {
				background: linear-gradient(135deg, var(--accent, #10b981), #06D6A0);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
			}
			.section-title {
				font-size: 2.5rem;
				font-weight: 800;
				text-align: center;
				margin-bottom: 1rem;
				letter-spacing: -0.02em;
			}
			.section-desc {
				font-size: 1.1rem;
				color: #94a3b8;
				text-align: center;
				max-width: 700px;
				margin: 0 auto 3rem;
			}

			/* Buttons */
			.primary-btn, .secondary-btn {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: 1rem 2.5rem;
				font-weight: 700;
				font-size: 1.1rem;
				border-radius: 0.5rem;
				text-decoration: none;
				transition: all 0.2s ease;
				cursor: pointer;
				border: none;
			}
			.primary-btn {
				background: linear-gradient(135deg, var(--accent, #10b981), #06D6A0);
				color: #0f172a;
				box-shadow: 0 4px 16px rgba(16, 185, 129, 0.25);
			}
			.primary-btn:hover {
				transform: translateY(-2px);
				box-shadow: 0 8px 24px rgba(16, 185, 129, 0.4);
			}
			.secondary-btn {
				background: rgba(255, 255, 255, 0.05);
				color: #fff;
				border: 1px solid rgba(255, 255, 255, 0.1);
			}
			.secondary-btn:hover {
				background: rgba(255, 255, 255, 0.1);
			}
			.w-full {
				width: 100%;
			}

			/* Hero Section */
			.hero-section {
				position: relative;
				padding: 8rem 0 6rem;
				overflow: hidden;
				text-align: center;
			}
			.hero-bg {
				position: absolute;
				inset: 0;
				background:
					radial-gradient(ellipse 80% 60% at 50% 0%, rgba(16, 185, 129, 0.08) 0%, transparent 60%),
					radial-gradient(ellipse 60% 50% at 80% 100%, rgba(6, 214, 160, 0.05) 0%, transparent 50%);
				z-index: 0;
			}
			.hero-content {
				position: relative;
				z-index: 1;
				max-width: 800px;
			}
			.eyebrow {
				display: inline-block;
				font-size: 0.85rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				color: var(--accent, #10b981);
				padding: 0.4rem 1.2rem;
				border: 1px solid rgba(16, 185, 129, 0.3);
				border-radius: 999px;
				background: rgba(16, 185, 129, 0.1);
				margin-bottom: 1.5rem;
			}
			.headline {
				font-size: clamp(2.5rem, 6vw, 4rem);
				font-weight: 800;
				line-height: 1.1;
				margin-bottom: 1.5rem;
			}
			.subheadline {
				font-size: 1.25rem;
				color: #94a3b8;
				margin-bottom: 2.5rem;
			}
			.cta-group {
				display: flex;
				gap: 1rem;
				justify-content: center;
			}

			/* Social Proof */
			.social-proof {
				padding: 2rem 0;
				border-top: 1px solid rgba(255, 255, 255, 0.05);
				border-bottom: 1px solid rgba(255, 255, 255, 0.05);
				text-align: center;
				background: rgba(0, 0, 0, 0.2);
			}
			.social-proof p {
				color: #64748b;
				font-size: 0.9rem;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				margin-bottom: 1rem;
			}
			.logos {
				display: flex;
				justify-content: center;
				gap: 3rem;
				flex-wrap: wrap;
				font-size: 1.25rem;
				color: #94a3b8;
				font-weight: 600;
			}
			.logos span {
				opacity: 0.7;
				transition: opacity 0.2s;
			}
			.logos span:hover {
				opacity: 1;
			}

			/* Problem Section */
			.problem-section {
				padding: 6rem 0;
				background: linear-gradient(to bottom, transparent, rgba(15, 23, 42, 0.5));
			}

			/* Modules Section */
			.modules-section {
				padding: 6rem 0;
			}
			.modules-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 2rem;
			}
			.module-card {
				background: rgba(30, 41, 59, 0.5);
				border: 1px solid rgba(255, 255, 255, 0.1);
				border-radius: 1rem;
				padding: 2rem;
				position: relative;
				overflow: hidden;
				transition: transform 0.3s ease, border-color 0.3s ease;
			}
			.module-card:hover {
				transform: translateY(-5px);
				border-color: var(--accent, #10b981);
			}
			.module-number {
				font-size: 0.8rem;
				font-weight: 700;
				text-transform: uppercase;
				color: var(--accent, #10b981);
				margin-bottom: 0.5rem;
				letter-spacing: 0.1em;
			}
			.module-title {
				font-size: 1.5rem;
				margin-bottom: 1rem;
				color: #fff;
			}
			.module-desc {
				color: #94a3b8;
				font-size: 1rem;
				line-height: 1.6;
			}
			.bonus-card {
				background: linear-gradient(145deg, rgba(30, 41, 59, 0.7), rgba(15, 23, 42, 0.8));
				border: 1px dashed rgba(16, 185, 129, 0.4);
			}
			.bonus-card .module-number {
				color: #fbbf24;
			}

			/* Testimonials */
			.testimonials-section {
				padding: 6rem 0;
				background: rgba(0, 0, 0, 0.2);
				border-top: 1px solid rgba(255, 255, 255, 0.05);
			}
			.testimonials-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
				gap: 2rem;
			}
			.testimonial-card {
				background: rgba(30, 41, 59, 0.8);
				padding: 2rem;
				border-radius: 1rem;
				border: 1px solid rgba(255, 255, 255, 0.05);
			}
			.stars {
				color: #fbbf24;
				font-size: 1.25rem;
				margin-bottom: 1rem;
			}
			.quote {
				font-size: 1.1rem;
				font-style: italic;
				color: #e2e8f0;
				margin-bottom: 1.5rem;
			}
			.author {
				display: flex;
				align-items: center;
				gap: 1rem;
			}
			.avatar {
				width: 48px;
				height: 48px;
				background: linear-gradient(135deg, #3b82f6, #8b5cf6);
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				font-weight: bold;
				color: #fff;
			}
			.author .name {
				font-weight: 700;
				color: #fff;
			}
			.author .role {
				font-size: 0.85rem;
				color: #94a3b8;
			}

			/* Pricing Section */
			.pricing-section {
				padding: 6rem 0 8rem;
			}
			.pricing-card-wrapper {
				max-width: 500px;
				margin: 0 auto;
			}
			.pricing-card {
				background: linear-gradient(145deg, rgba(30, 41, 59, 0.9), rgba(15, 23, 42, 0.9));
				border: 1px solid rgba(16, 185, 129, 0.3);
				border-radius: 1.5rem;
				padding: 3rem 2.5rem;
				text-align: center;
				position: relative;
				box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(16, 185, 129, 0.1);
			}
			.popular-badge {
				position: absolute;
				top: -12px;
				left: 50%;
				transform: translateX(-50%);
				background: var(--accent, #10b981);
				color: #0f172a;
				padding: 0.25rem 1rem;
				border-radius: 999px;
				font-size: 0.8rem;
				font-weight: 800;
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}
			.plan-name {
				font-size: 1.5rem;
				color: #fff;
				margin-bottom: 1rem;
			}
			.price {
				display: flex;
				align-items: flex-start;
				justify-content: center;
				margin-bottom: 0.5rem;
			}
			.currency {
				font-size: 1.5rem;
				font-weight: 700;
				margin-top: 0.5rem;
				color: #94a3b8;
			}
			.amount {
				font-size: 4.5rem;
				font-weight: 800;
				line-height: 1;
				color: #fff;
			}
			.guarantee {
				color: var(--accent, #10b981);
				font-size: 0.9rem;
				font-weight: 600;
				margin-bottom: 2rem;
			}
			.features {
				list-style: none;
				padding: 0;
				margin: 0 0 2rem;
				text-align: left;
			}
			.features li {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				margin-bottom: 1rem;
				color: #e2e8f0;
				font-size: 1.05rem;
			}

			/* Responsive */
			@media (max-width: 768px) {
				.cta-group {
					flex-direction: column;
				}
				.headline {
					font-size: 2.5rem;
				}
				.pricing-card {
					padding: 2rem 1.5rem;
				}
			}
		</style>
	</body>
</html>
