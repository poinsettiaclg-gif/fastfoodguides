---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION } from '../../consts';

const articles = await getCollection('articles');
const secretMenus = await getCollection('secretMenus');
const allPosts = [...articles, ...secretMenus].sort((a, b) => {
	if (a.collection === 'articles' && b.collection === 'secretMenus') return -1;
	if (a.collection === 'secretMenus' && b.collection === 'articles') return 1;
	return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});

const chainCounts = allPosts.reduce((acc, post) => {
	const chain = post.data.chain;
	if (chain) acc[chain] = (acc[chain] || 0) + 1;
	return acc;
}, {} as Record<string, number>);

const chains = Object.entries(chainCounts)
	.filter(([, count]) => count >= 3)
	.map(([chain]) => chain) as string[];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="All Articles | Fast Food Guides" description={SITE_DESCRIPTION} noindex={false} />
		<style>
			body {
				background: var(--bg-body);
				color: var(--text-primary);
			}

			main {
				width: 100%;
				max-width: 1100px;
				margin: 0 auto;
				padding: 2rem 1rem 4rem;
			}

			/* — Page header — */
			.page-header {
				margin-bottom: 2rem;
			}

			.page-header h1 {
				margin: 0 0 0.25rem 0;
				font-size: 2rem;
				font-weight: 800;
				color: var(--text-primary);
				letter-spacing: -0.02em;
			}

			.guide-count {
				font-size: 0.875rem;
				color: #94A3B8;
			}

			.guide-count strong {
				color: var(--accent);
				font-weight: 600;
			}

			/* — Chain filter pills — */
			.chain-filters {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-bottom: 2rem;
				padding-bottom: 1.5rem;
				border-bottom: 1px solid rgba(255, 255, 255, 0.08);
			}

			.chain-pill {
				display: inline-block;
				padding: 0.3em 0.75em;
				font-size: 0.8rem;
				font-weight: 500;
				color: #94A3B8;
				background: var(--bg-surface);
				border: 1px solid rgba(255, 255, 255, 0.08);
				border-radius: 2rem;
				cursor: pointer;
				transition: all 0.2s ease;
				text-decoration: none;
				line-height: 1.4;
			}

			.chain-pill:hover,
			.chain-pill.active {
				color: var(--accent);
				background: rgba(16, 185, 129, 0.1);
				border-color: rgba(16, 185, 129, 0.3);
			}

			/* — Article grid — */
			.article-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.25rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}

			/* — Article card — */
			.article-card {
				display: flex;
				flex-direction: column;
				background: #1a2332;
				border: 1px solid rgba(255, 255, 255, 0.08);
				border-radius: 0.75rem;
				overflow: hidden;
				transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
			}

			.article-card:hover {
				background: #1f2b3d;
				border-color: rgba(16, 185, 129, 0.3);
				transform: translateY(-2px);
			}

			.article-card a {
				display: flex;
				flex-direction: column;
				flex: 1;
				padding: 1.25rem;
				text-decoration: none;
				color: inherit;
			}

			.card-meta {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				margin-bottom: 0.6rem;
			}

			.card-chain {
				font-size: 0.7rem;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.04em;
				color: var(--accent);
				background: rgba(16, 185, 129, 0.12);
				border: 1px solid rgba(16, 185, 129, 0.25);
				padding: 0.15em 0.5em;
				border-radius: 0.25rem;
				line-height: 1.4;
			}

			.card-date {
				font-size: 0.75rem;
				color: #94A3B8;
			}

			.card-title {
				margin: 0 0 0.5rem 0;
				font-size: 1.05rem;
				font-weight: 700;
				color: var(--text-primary);
				line-height: 1.35;
				transition: color 0.2s ease;
			}

			.article-card:hover .card-title {
				color: #34D399;
			}

			.card-description {
				margin: 0;
				font-size: 0.875rem;
				color: #94A3B8;
				line-height: 1.55;
				flex: 1;
			}

			/* — Responsive — */
			@media (max-width: 720px) {
				main {
					padding: 1.5rem 0.75rem 3rem;
				}

				.page-header h1 {
					font-size: 1.6rem;
				}

				.article-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<a href="#main-content" class="sr-only skip-link">Skip to main content</a>
		<Header />
		<main id="main-content">
			<div class="page-header">
				<h1>All Guides</h1>
				<p class="guide-count">Showing <strong>{allPosts.length}</strong> guides</p>
			</div>

			{chains.length > 0 && (
				<nav class="chain-filters" aria-label="Filter by chain">
					<a href="/articles/" class="chain-pill active" data-chain="all">All</a>
					{chains.sort().map((chain) => (
						<a href={`/articles/chain/${chain.toLowerCase().replace(/['']/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}/`} class="chain-pill" data-chain={chain}>{chain}</a>
					))}
				</nav>
			)}

			<ul class="article-grid" role="list">
				{allPosts.map((post) => {
					const desc = post.data.description;
					const truncated = desc.length > 120 ? desc.slice(0, 117) + '…' : desc;
					return (
						<li class="article-card" data-chain={post.data.chain || ''} style={post.collection === 'secretMenus' ? "border: 1px solid rgba(248, 113, 113, 0.2);" : ""}>
							<a href={post.collection === 'secretMenus' ? `/secret-menus/${post.id}/` : `/articles/${post.id}/`}>
								<div class="card-meta">
									{post.data.chain && <span class="card-chain">{post.data.chain}</span>}
									<span class="card-date"><FormattedDate date={post.data.pubDate} /></span>
								</div>
								<h2 class="card-title">{post.data.title}</h2>
								<p class="card-description">{truncated}</p>
							</a>
						</li>
					);
				})}
			</ul>
		</main>
		<Footer />

	</body>
</html>
