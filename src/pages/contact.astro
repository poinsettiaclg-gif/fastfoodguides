---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

const schema = {
	"@context": "https://schema.org",
	"@type": "ContactPage",
	"name": `Contact | ${SITE_TITLE}`,
	"description": "Contact Fast Food Guides Media LLC.",
	"publisher": {
		"@type": "Organization",
		"name": "Fast Food Guides Media LLC",
		"address": {
			"@type": "PostalAddress",
			"streetAddress": "701 S. Carson St, Ste 200",
			"addressLocality": "Carson City",
			"addressRegion": "NV",
			"postalCode": "89701",
			"addressCountry": "US"
		},
		"email": "contact@fastfoodguides.com"
	}
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Contact | ${SITE_TITLE}`} description="Get in touch with Fast Food Guides. Reach out for general questions, content corrections, business inquiries, or contributor applications." noindex={false} />
		<script type="application/ld+json" set:html={JSON.stringify(schema)} />
	</head>
	<body>
		<a href="#main-content" class="sr-only skip-link">Skip to main content</a>
		<Header />
		<main id="main-content">
			<div class="contact-page">
				<div class="page-header">
					<h1>Get in Touch</h1>
					<p class="subtitle">
						Have a question, correction, or business proposal? We'd love to hear from you.
						Fill out the form below or choose a category that best fits your inquiry.
					</p>
				</div>

				<div class="form-container">
					<form action="#" method="POST" id="contactForm" class="contact-form">
						<div class="form-group">
							<label for="name">Name</label>
							<input type="text" id="name" name="name" required placeholder="Jane Doe" />
						</div>
						<div class="form-group">
							<label for="email">Email</label>
							<input type="email" id="email" name="email" required placeholder="jane@example.com" />
						</div>
						<div class="form-group">
							<label for="subject">Subject</label>
							<select id="subject" name="subject" required>
								<option value="">Select a topic...</option>
								<option value="general">General Questions</option>
								<option value="correction">Corrections & Updates</option>
								<option value="business">Business Inquiries</option>
								<option value="contributor">Contributor Applications</option>
							</select>
						</div>
						<div class="form-group">
							<label for="message">Message</label>
							<textarea id="message" name="message" rows="5" required placeholder="How can we help?"></textarea>
						</div>
						<button type="submit" class="submit-btn">Send Message</button>
						<p id="form-status" class="form-status" aria-live="polite"></p>
					</form>
				</div>

				<script>
					const form = document.getElementById('contactForm');
					const status = document.getElementById('form-status');
					if (form && status) {
						form.addEventListener('submit', (e) => {
							e.preventDefault();
							status.textContent = 'Thank you for your message! We will get back to you within 1-2 business days.';
							status.style.color = 'var(--accent)';
							form.reset();
						});
					}
				</script>

				<h2 class="section-heading">What Can We Help With?</h2>

				<div class="inquiry-grid" role="list">
					<div class="inquiry-card" role="listitem">
						<div class="card-icon" aria-hidden="true">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="12" cy="12" r="10"></circle>
								<path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
								<path d="M12 17h.01"></path>
							</svg>
						</div>
						<h3>General Questions</h3>
						<p>
							Curious about something on the site? Have a suggestion for a new guide or topic
							you'd like us to cover? We're always open to hearing from our readers.
						</p>
					</div>

					<div class="inquiry-card" role="listitem">
						<div class="card-icon" aria-hidden="true">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M12 20h9"></path>
								<path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z"></path>
							</svg>
						</div>
						<h3>Corrections &amp; Updates</h3>
						<p>
							Noticed outdated information or an error in one of our guides? Menu items change
							frequently — let us know and we'll get it updated as soon as possible.
						</p>
					</div>

					<div class="inquiry-card" role="listitem">
						<div class="card-icon" aria-hidden="true">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M20 7h-9"></path>
								<path d="M14 17H5"></path>
								<circle cx="17" cy="17" r="3"></circle>
								<circle cx="7" cy="7" r="3"></circle>
							</svg>
						</div>
						<h3>Business Inquiries</h3>
						<p>
							Interested in advertising, sponsorships, or partnerships? We're open to
							collaborating with brands and businesses that align with our audience and values.
						</p>
					</div>

					<div class="inquiry-card" role="listitem">
						<div class="card-icon" aria-hidden="true">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
								<circle cx="9" cy="7" r="4"></circle>
								<line x1="19" x2="19" y1="8" y2="14"></line>
								<line x1="22" x2="16" y1="11" y2="11"></line>
							</svg>
						</div>
						<h3>Contributor Applications</h3>
						<p>
							Have QSR experience and a passion for writing? We're always looking for
							knowledgeable contributors who can share authentic, behind-the-counter insights.
						</p>
					</div>
				</div>

				<div class="response-notice">
					<div class="notice-icon" aria-hidden="true">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="10"></circle>
							<polyline points="12 6 12 12 16 14"></polyline>
						</svg>
					</div>
					<p>
						We typically respond within <strong>1–2 business days</strong>. Please include as
						much detail as possible in your message so we can assist you effectively.
					</p>
				</div>

				<div class="entity-notice">
					<div class="entity-icon" aria-hidden="true">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
							<circle cx="12" cy="10" r="3"></circle>
						</svg>
					</div>
					<div class="entity-details">
						<h4>Editorial Office &amp; Publishing Entity</h4>
						<p>
							<strong>Fast Food Guides Media LLC</strong><br>
							701 S. Carson St, Ste 200<br>
							Carson City, NV 89701<br>
							<span class="entity-meta">An Independent QSR Industry Publication &amp; Research Archive</span>
						</p>
					</div>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	body {
		background-color: var(--bg-body);
		color: var(--text-primary);
		font-family: var(--font-atkinson), system-ui, sans-serif;
		margin: 0;
	}

	main {
		padding: 3rem 1.5rem 4rem;
	}

	.contact-page {
		max-width: 720px;
		margin: 0 auto;
	}

	.page-header {
		text-align: center;
		margin-bottom: 2.5rem;
	}

	.page-header h1 {
		font-size: 2.5rem;
		font-weight: 800;
		background: linear-gradient(135deg, var(--accent), #06D6A0);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		margin-bottom: 0.75rem;
	}

	.page-header .subtitle {
		color: #94A3B8;
		font-size: 1.125rem;
		line-height: 1.7;
		max-width: 560px;
		margin: 0 auto;
	}

	/* Email / Form */
	.form-container {
		background: #1a2332;
		border: 1px solid rgba(16, 185, 129, 0.3);
		border-radius: 0.75rem;
		padding: 2rem;
		margin-bottom: 3rem;
		box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3), 0 2px 4px -2px rgba(0, 0, 0, 0.2);
	}

	.form-group {
		margin-bottom: 1.5rem;
	}

	.form-group label {
		display: block;
		margin-bottom: 0.5rem;
		font-weight: 600;
		color: #CBD5E1;
		font-size: 0.95rem;
	}

	.form-group input,
	.form-group select,
	.form-group textarea {
		width: 100%;
		padding: 0.875rem;
		background: rgba(0, 0, 0, 0.2);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 0.5rem;
		color: var(--text-primary);
		font-family: inherit;
		font-size: 1rem;
		box-sizing: border-box;
	}

	.form-group input:focus,
	.form-group select:focus,
	.form-group textarea:focus {
		outline: none;
		border-color: var(--accent);
		background: rgba(0, 0, 0, 0.3);
	}

	.submit-btn {
		background: linear-gradient(135deg, var(--accent), #06D6A0);
		color: var(--bg-body);
		border: none;
		padding: 0.875rem 2rem;
		border-radius: 0.5rem;
		font-weight: 700;
		font-size: 1.05rem;
		cursor: pointer;
		width: 100%;
		transition: opacity 0.2s ease, transform 0.2s ease;
	}

	.submit-btn:hover {
		opacity: 0.9;
		transform: translateY(-1px);
	}

	.form-status {
		margin-top: 1rem;
		text-align: center;
		font-weight: 600;
		min-height: 1.5rem;
	}

	/* Section heading */
	.section-heading {
		font-size: 1.375rem;
		font-weight: 700;
		color: var(--text-primary);
		margin-bottom: 1.25rem;
	}

	/* Inquiry Cards Grid */
	.inquiry-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin-bottom: 2.5rem;
	}

	.inquiry-card {
		background: #1a2332;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 0.75rem;
		padding: 1.5rem;
		transition: background-color 0.2s ease, border-color 0.2s ease;
	}

	.inquiry-card:hover {
		background: #1f2b3d;
		border-color: rgba(16, 185, 129, 0.3);
	}

	.card-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		background: rgba(16, 185, 129, 0.1);
		border-radius: 0.5rem;
		color: var(--accent);
		margin-bottom: 1rem;
	}

	.inquiry-card h3 {
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--text-primary);
		margin: 0 0 0.5rem;
	}

	.inquiry-card p {
		font-size: 0.9rem;
		color: #94A3B8;
		line-height: 1.6;
		margin: 0;
	}

	/* Response Notice */
	.response-notice {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		background: var(--bg-surface);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 0.75rem;
		padding: 1.25rem 1.5rem;
		margin-bottom: 1.5rem;
	}

	.notice-icon {
		color: var(--accent);
		flex-shrink: 0;
		margin-top: 0.1rem;
	}

	.response-notice p {
		color: #94A3B8;
		font-size: 0.9rem;
		line-height: 1.6;
		margin: 0;
	}

	.response-notice strong {
		color: var(--text-primary);
	}

	/* Entity Notice Block */
	.entity-notice {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		background: #1a2332;
		border: 1px solid rgba(14, 165, 233, 0.3);
		border-radius: 0.75rem;
		padding: 1.5rem;
	}

	.entity-icon {
		color: #0EA5E9;
		flex-shrink: 0;
		margin-top: 0.15rem;
	}

	.entity-details h4 {
		color: var(--text-primary);
		font-size: 1rem;
		font-weight: 700;
		margin: 0 0 0.4rem 0;
	}

	.entity-details p {
		color: #CBD5E1;
		font-size: 0.9rem;
		line-height: 1.6;
		margin: 0;
	}

	.entity-meta {
		display: block;
		margin-top: 0.5rem;
		font-size: 0.8rem;
		color: #94A3B8;
		font-style: italic;
	}

	/* Responsive */
	@media (max-width: 600px) {
		.inquiry-grid {
			grid-template-columns: 1fr;
		}

		.page-header h1 {
			font-size: 2rem;
		}
	}
</style>
