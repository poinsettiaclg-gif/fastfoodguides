---
import type { CollectionEntry } from 'astro:content';
import { getCollection, getEntries } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import NewsletterCTA from '../components/NewsletterCTA.astro';
import AdPlaceholder from '../components/AdPlaceholder.astro';
import YMYLDisclaimer from '../components/YMYLDisclaimer.astro';

type Props = CollectionEntry<'secretMenus'>['data'];

const { title, description, pubDate, heroImage, chain, operationalAnnoyanceScore, isVerified, ingredients, howToOrder, priceEstimate, relatedArticles, faq, disclaimerType, author, authorTitle } = Astro.props;

const allArticles = await getCollection('articles');
let resolvedRelated: CollectionEntry<'articles'>[] = [];
if (relatedArticles && relatedArticles.length > 0) {
	resolvedRelated = await getEntries(relatedArticles);
}
if (resolvedRelated.length < 3 && chain) {
	const fallbackArticles = allArticles
		.filter(a => a.data.chain === chain && !resolvedRelated.find(r => r.id === a.id))
		.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
		.slice(0, 3 - resolvedRelated.length);
	resolvedRelated = [...resolvedRelated, ...fallbackArticles];
}

// Build breadcrumb path
function slugifyChain(c: string): string {
	return c.toLowerCase().replace(/['']/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}

// Generate Annoyance Color
let annoyanceColor = 'var(--accent)'; // Green
if (operationalAnnoyanceScore >= 4) annoyanceColor = '#F59E0B'; // Yellow
if (operationalAnnoyanceScore >= 8) annoyanceColor = '#EF4444'; // Red

const schemas = [
	{
		"@type": "Recipe",
		"name": title,
		"description": description,
		"image": heroImage ? [new URL(heroImage.src, Astro.site).href] : ["https://fastfoodguides.com/og-default.png"],
		"datePublished": pubDate ? new Date(pubDate).toISOString() : new Date().toISOString(),
		"totalTime": "PT5M",
		"recipeIngredient": ingredients,
		"recipeInstructions": [{ "@type": "HowToStep", "text": howToOrder }],
		"author": {
			"@type": "Person",
			"name": author || "Russell Roseberry",
			"jobTitle": authorTitle || "Multi-Unit Kitchen Manager",
			"url": "https://fastfoodguides.com/author/" + (author ? author.toLowerCase().replace(/ /g, '-') : "russell-roseberry"),
			"image": "https://fastfoodguides.com/images/" + (author ? author.toLowerCase().replace(/ /g, '-') : "russell-roseberry") + ".jpg"
		},
		"publisher": {
			"@type": "Organization",
			"name": "Fast Food Guides",
			"url": "https://fastfoodguides.com",
			"logo": {
				"@type": "ImageObject",
				"url": "https://fastfoodguides.com/og-default.png"
			}
		}
	}
];

if (faq && faq.length > 0) {
	schemas.push({
		"@type": "FAQPage",
		"mainEntity": faq.map((q: any) => ({
			"@type": "Question",
			"name": q.question,
			"acceptedAnswer": {
				"@type": "Answer",
				"text": q.answer
			}
		}))
	} as any);
}
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage?.src} ogType="article" chain={chain} articlePath={Astro.url.pathname} />
		<script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": schemas }).replace(/</g, '\\u003c')} />
		<style>
			.secret-menu-container {
				max-width: 800px;
				margin: 0 auto;
				padding: 2rem 1rem;
			}
			.breadcrumb {
				font-size: 0.9rem;
				color: #94A3B8;
				margin-bottom: 2rem;
				text-align: center;
			}
			.breadcrumb a {
				color: var(--accent);
				text-decoration: none;
			}
			.breadcrumb a:hover {
				text-decoration: underline;
			}
			.sm-header {
				margin-bottom: 2rem;
				text-align: center;
			}
			.sm-header h1 {
				margin: 0 0 1rem 0;
				font-size: 2.5rem;
				color: #F8FAFC;
			}
			.sm-hero {
				width: 100%;
				aspect-ratio: 16/9;
				object-fit: cover;
				border-radius: 0.75rem;
				box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3);
				margin-bottom: 2rem;
			}
			.sm-dashboard {
				display: grid;
				grid-template-columns: 1fr;
				gap: 1.5rem;
				margin-bottom: 2rem;
			}
			@media(min-width: 640px) {
				.sm-dashboard {
					grid-template-columns: 1fr 1fr;
				}
			}
			.sm-card {
				background-color: #1E293B;
				border: 1px solid #334155;
				border-radius: 0.75rem;
				padding: 1.5rem;
			}
			.sm-card h2 {
				margin: 0 0 1rem 0;
				color: #94A3B8;
				font-size: 1rem;
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}
			.annoyance-score {
				font-size: 3rem;
				font-weight: 900;
				line-height: 1;
			}
			.ingredients-list {
				list-style-type: none;
				padding: 0;
				margin: 0;
			}
			.ingredients-list li {
				padding: 0.5rem 0;
				border-bottom: 1px solid #334155;
				color: #E2E8F0;
			}
			.ingredients-list li:last-child {
				border-bottom: none;
			}
			.script-box {
				background-color: #0F172A;
				border-left: 4px solid #3B82F6;
				padding: 1.5rem;
				border-radius: 0.375rem;
				margin-top: 1rem;
				font-family: monospace;
				font-size: 1.125rem;
				color: #60A5FA;
			}
			.prose {
				color: #CBD5E1;
				line-height: 1.7;
				font-size: 1.125rem;
				margin-top: 3rem;
			}
			.prose h2 {
				color: #F8FAFC;
				margin-top: 2rem;
			}
			.faq-section {
				margin-top: 3rem;
				padding-top: 2rem;
				border-top: 1px solid rgba(255, 255, 255, 0.08);
			}
			.faq-section h2 {
				font-size: 1.5rem;
				font-weight: 700;
				color: #F8FAFC;
				margin: 0 0 1.5rem 0;
			}
			.faq-item {
				margin-bottom: 1.5rem;
			}
			.faq-item h3 {
				font-size: 1.1rem;
				font-weight: 600;
				color: #E2E8F0;
				margin: 0 0 0.5rem 0;
			}
			.faq-item p {
				color: #CBD5E1;
				margin: 0;
				line-height: 1.6;
			}
			/* — Related Section — */
			.related-section {
				margin-top: 3rem;
				padding-top: 2rem;
				border-top: 1px solid rgba(255, 255, 255, 0.08);
			}
			.related-section h2 {
				font-size: 1.5rem;
				font-weight: 700;
				color: #F8FAFC;
				margin: 0 0 1.5rem 0;
			}
			.related-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
				gap: 1.25rem;
			}
			.related-card {
				display: flex;
				flex-direction: column;
				padding: 1.25rem;
				background: rgba(255, 255, 255, 0.02);
				border: 1px solid rgba(255, 255, 255, 0.08);
				border-radius: 0.75rem;
				text-decoration: none;
				transition: all 0.2s ease;
			}
			.related-card:hover {
				border-color: rgba(16, 185, 129, 0.3);
				background: rgba(16, 185, 129, 0.05);
			}
			.related-card .rc-chain {
				display: inline-block;
				font-size: 0.7rem;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.04em;
				color: var(--accent);
				margin-bottom: 0.4rem;
			}
			.related-card .rc-title {
				font-size: 0.9rem;
				font-weight: 600;
				color: #E2E8F0;
				line-height: 1.35;
			}
		</style>
	</head>
	<body>
		<a href="#main-content" class="sr-only skip-link">Skip to main content</a>
		<Header />
		<main id="main-content">
			<article class="secret-menu-container">
				<div class="sm-header">
					<nav aria-label="Breadcrumb" class="breadcrumb">
						<a href="/">Home</a> &gt; <a href="/secret-menus/">Secret Menus</a> &gt; <a href={`/articles/chain/${slugifyChain(chain)}/`}>{chain}</a> &gt; <span>{title}</span>
					</nav>
					<h1>{title}</h1>
				</div>

				{heroImage && <Image src={heroImage} alt={title} class="sm-hero" width={800} height={450} format="webp" loading="eager" fetchpriority="high" decoding="async" />}

				<div class="sm-dashboard">
					<div class="sm-card" style={`border-top: 4px solid ${annoyanceColor};`}>
						<h2>Operational Annoyance Score</h2>
						<div class="annoyance-score" style={`color: ${annoyanceColor};`}>{operationalAnnoyanceScore}/10</div>
						<p style="color: #94A3B8; margin-top: 0.5rem;">How much the kitchen will hate you for ordering this.</p>
					</div>

					<div class="sm-card">
						<h2>Ingredients</h2>
						<ul class="ingredients-list">
							{ingredients.map(ing => (
								<li>{ing}</li>
							))}
						</ul>
						{priceEstimate && <p style="margin-top: 1rem; font-weight: 600; color: #E2E8F0;">Est. Price: {priceEstimate}</p>}
					</div>
				</div>

				<div class="sm-card">
					<h2>Exactly What to Say at the Speaker</h2>
					<div class="script-box">
						"{howToOrder}"
					</div>
				</div>

				<div class="prose">
					{disclaimerType && <YMYLDisclaimer type={disclaimerType} />}
					<slot />
				</div>

				<NewsletterCTA />
				
				{faq && faq.length > 0 && (
					<section class="faq-section">
						<h2>Frequently Asked Questions</h2>
						{faq.map((item: any) => (
							<div class="faq-item">
								<h3>{item.question}</h3>
								<p>{item.answer}</p>
							</div>
						))}
					</section>
				)}

				<AdPlaceholder slot="secret-menu-bottom" />

				<!-- Related Articles (auto-rendered from frontmatter) -->
				{resolvedRelated.length > 0 && (
					<section class="related-section">
						<h2>More Insider Guides</h2>
						<div class="related-grid">
							{resolvedRelated.map(article => (
								<a href={`/articles/${article.id}/`} class="related-card">
									{article.data.chain && <span class="rc-chain">{article.data.chain}</span>}
									<span class="rc-title">{article.data.title}</span>
								</a>
							))}
						</div>
					</section>
				)}
			</article>
		</main>
		<Footer />
	</body>
</html>
